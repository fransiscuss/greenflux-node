{
  "name": "@fransiscuss/greenflux",
  "version": "0.3.0",
  "description": "Unofficial TypeScript client for the Greenflux CPMS APIs.",
  "license": "MIT",
  "author": "Fransiscus Setiawan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fransiscuss/greenflux-node.git"
  },
  "bugs": {
    "url": "https://github.com/fransiscuss/greenflux-node/issues"
  },
  "homepage": "https://github.com/fransiscuss/greenflux-node#readme",
  "keywords": [
    "greenflux",
    "cpms",
    "ev",
    "charging",
    "ocpi",
    "smart-charging"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "integration": "tsx examples/integration-harness.ts",
    "smoke": "tsx examples/cpms-smoke-test.ts",
    "example:charge-assist": "npm run build && tsx examples/charge-assist-session.ts",
    "prepack": "npm run build",
    "verify": "npm run check && npm test && npm run integration && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
